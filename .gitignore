# Phase 0: downloaded models and local binaries
scripts/phase0/models/
scripts/phase0/depth-bench/depth-bench
scripts/phase0/*.log
# Personal test photos and everything derived from them (never committed)
scripts/phase0/real-photos/
scripts/phase0/results/depth/
