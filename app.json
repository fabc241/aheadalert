{
  "expo": {
    "name": "AheadAlert",
    "slug": "ahead-alert",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.fabc241.aheadalert",
      "infoPlist": {
        "NSCameraUsageDescription": "La fotocamera serve per riconoscere ostacoli, gradini e cambi di luce davanti a te. Le immagini restano sul telefono.",
        "NSMicrophoneUsageDescription": "Il microfono serve per i comandi vocali (\"Avvia guida\", \"Cosa ho davanti\"…). Ciò che dici resta sul telefono."
      }
    },
    "android": {
      "package": "io.github.fabc241.aheadalert",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 31
          }
        }
      ],
      [
        "@qvac/sdk/expo-plugin",
        {
          "installMissingPrebuilds": true
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ],
      "expo-router"
    ],
    "scheme": "aheadalert"
  }
}
